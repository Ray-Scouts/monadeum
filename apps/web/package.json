{
  "name": "@monadeum/web",
  "private": true,
  "type": "module",
  "scripts": {
    "libs": "tsc -p ../../libs/fitness && tsc -p ../../libs/reallocation && tsc -p ../../libs/reproduction && tsc -p ../../libs/recovery && tsc -p ../../simulation",
    "predev": "bun run libs",
    "dev": "next dev",
    "prebuild": "bun run libs",
    "build": "next build",
    "start": "next start",
    "test": "bun run libs && tsc --noEmit && bun test src && next build"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "@monadeum/fitness": "workspace:*",
    "@monadeum/reallocation": "workspace:*",
    "@monadeum/recovery": "workspace:*",
    "@privy-io/react-auth": "3.48.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "monadeum-simulation": "workspace:*",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
