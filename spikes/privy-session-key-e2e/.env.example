# Copy to .env and fill in. .env is gitignored. Neither required value is a secret, but keep .env out of git anyway.
# Privy app ID from the Privy dashboard. It is public and ships in the browser bundle. Never put the Privy app secret here.
VITE_PRIVY_APP_ID=
# ZeroDev bundler URL for Monad testnet: https://rpc.zerodev.app/api/v3/<projectId>/chain/10143
# Read by the page (owner revocation) and by the server (session key UserOps).
VITE_ZERODEV_RPC=
# Optional overrides
# VITE_MONAD_RPC=https://testnet-rpc.monad.xyz
# MONAD_RPC=https://testnet-rpc.monad.xyz
# VITE_FUND_MON=2
