# Copy to .env and fill in. .env is gitignored. Never commit a key.
# Testnet-only key holding a little testnet MON for gas and at least AMOUNT_IN of the market's quote token.
# Never a key that holds mainnet assets. Not needed for DRY_RUN=1.
OWNER_PRIVATE_KEY=
# MON/USD at test time, set by hand, and the named source and time it was read from. Required for a live run.
# Example: MON_USD_SOURCE="CoinGecko MON/USD, 2026-10-08 14:00 UTC"
MON_USD=
MON_USD_SOURCE=
# Optional overrides
MONAD_RPC=https://testnet-rpc.monad.xyz
# Kuru testnet router and MON-USDC market, from https://docs.kuru.io/contracts/Contract-addresses (read 2026-10-08)
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
KURU_MARKET=0xa241896A7Dbe8a550D2E5fF7A914bB1989ceD2D9
# Quote token amount to spend, in whole units (1 = 1 USDC)
AMOUNT_IN=1
# minAmountOut is the quote less this many bps
SLIPPAGE_BPS=50
# Gas limit is the estimate plus this many bps. Monad charges the limit, so this buffer is paid in full.
GAS_BUFFER_BPS=1000
# Refuse to run above this gas price
MAX_GAS_PRICE_GWEI=300
# Set to 1 to read the market, quote by simulation, and stop before any signing or write
DRY_RUN=
