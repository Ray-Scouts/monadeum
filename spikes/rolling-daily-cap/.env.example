# Copy to .env and fill in. .env is gitignored. Never commit a key.
# ZeroDev bundler URL for Monad testnet: https://rpc.zerodev.app/api/v3/<projectId>/chain/10143
ZERODEV_RPC=
# Testnet-only key that owns the agent account and funds it. Never a key that holds mainnet assets.
OWNER_PRIVATE_KEY=
# Optional overrides
MONAD_RPC=https://testnet-rpc.monad.xyz
CAP_PER_CALL_MON=0.001
RATE_LIMIT_COUNT=3
WINDOW_SECONDS=120
FUND_MON=0.05
# Seconds between reset probes. Each rejected probe costs nothing; each accepted one spends CAP_PER_CALL_MON.
POLL_SECONDS=5
