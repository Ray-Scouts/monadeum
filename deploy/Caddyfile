# TLS reverse proxy for the `proxy` profile of docker-compose.yml. Caddy obtains and renews certificates for both
# domains itself; their DNS A (and AAAA) records must point at this VPS, and ports 80 and 443 must be open.
# Caddy sets X-Forwarded-For, which is why the API runs with API_TRUST_PROXY=true behind it.

{$WEB_DOMAIN} {
	encode zstd gzip
	# The web app answers `/` and `/evidence` with markdown when the request's Accept lists text/markdown, and with HTML
	# otherwise. Next.js sets its own Vary on the HTML response, so Accept is appended here to keep caches from mixing the two.
	@negotiated path / /evidence
	header @negotiated +Vary Accept
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	reverse_proxy api:3001
}

# The bare domain and www only redirect to the web app, whose root route is the landing. The app is not served here
# directly, because sign-in is bound to WEB_DOMAIN (AUTH_SIWE_DOMAIN) and the API's CORS allows only that origin.
{$ROOT_DOMAIN}, www.{$ROOT_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
