# Monadeum on Monad testnet, one VPS. Copy to deploy/.env.testnet (gitignored), chmod 600, and fill in every
# CHANGE_ME. Read by `docker compose --env-file deploy/.env.testnet -f deploy/docker-compose.yml ...`.
#
# Values marked FACT were read on chain or from a vendor on 2026-10-11. Values marked DECIDED are the owner's
# decisions recorded in ARCHITECTURE.md. Values marked STARTING are proposed starting values, not measurements.
# Generate every password with `openssl rand -hex 32` (hex keeps it safe inside the connection URLs).

# ---------------------------------------------------------------------------------------------------------------------
# Domains and binding
# ---------------------------------------------------------------------------------------------------------------------
# The web app's host. AUTH_SIWE_DOMAIN and AUTH_SIWE_URI (https://WEB_DOMAIN) are derived from it, and it is the only
# origin the API's CORS allows. Web and API must be same-site (the session cookie is SameSite=Strict).
WEB_DOMAIN=app.CHANGE_ME.example
# The API's host. The web app is built against https://API_DOMAIN.
API_DOMAIN=api.CHANGE_ME.example
# Where web (3000) and api (3001) are published. Keep 127.0.0.1 with a reverse proxy in front (the `proxy` profile, or
# one on the host); 0.0.0.0 exposes them without TLS.
BIND_ADDRESS=127.0.0.1
# true behind a proxy that sets X-Forwarded-For (Caddy does), false otherwise.
API_TRUST_PROXY=true

# ---------------------------------------------------------------------------------------------------------------------
# Chain (FACT: chain id 10143 answered by this RPC on 2026-10-11)
# ---------------------------------------------------------------------------------------------------------------------
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Testnet USDC. FACT, on chain 2026-10-11: name "USDC", symbol "USDC", decimals 6, EIP-712 version "2", a domain
# separator equal to the one computed for chain 10143 and this address, the EIP-3009 type hashes, and both
# transferWithAuthorization forms in its implementation (a FiatToken-style proxy). FACT, 2026-10-11: Circle lists this
# address as USDC on Monad Testnet (https://developers.circle.com/stablecoins/usdc-contract-addresses), and Circle's
# faucet (https://faucet.circle.com) serves Monad Testnet, 20 USDC per address every 2 hours.
SETTLEMENT_ASSET=0x534b2f3A21130d7a60830c2Df862319e593943A3
SETTLEMENT_DECIMALS=6

# ---------------------------------------------------------------------------------------------------------------------
# Contracts. FACT: the testnet deployment of 2026-10-11, recorded in contracts/deployments/monad-testnet.json and
# checked on chain the same day (code present, constructor-set values read back). Change these only for a redeployment.
# ---------------------------------------------------------------------------------------------------------------------
# AgentSpendPolicy, deployed in block 70167444.
SPEND_POLICY_ADDRESS=0xe54512401B8fCD0DCc3f4Aa4929b99F05AbA3f05
# AgentReallocation, block 70167453. Its EIP-712 domain names this address.
REALLOCATION_CONTRACT=0x4e7500415e81017670a9cFb8763f873EE6694A7f
# The block in which AgentSpendPolicy was deployed: the indexer's first block.
INDEXER_START_BLOCK=70167444
# Optional. Envio HyperSync API token, read only by the operator-run cross-check (`bun run indexer:crosscheck`), never by
# a service. Create one at https://app.envio.dev/api-tokens. Leave empty to skip the cross-check; it then reports
# "unverified". Never commit a value. ENVIO_HYPERSYNC_URL defaults to https://10143.hypersync.xyz.
ENVIO_API_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Database (Postgres 17 in the compose file)
# ---------------------------------------------------------------------------------------------------------------------
# The image's superuser. Used only by the image's first-start initialization and for backups.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# monadeum_owner: owns the schema, runs the migration step, never used by a service.
DB_OWNER_PASSWORD=CHANGE_ME
# The per-process login roles the migration step creates: monadeum_api_login (member of monadeum_api and
# monadeum_reader), monadeum_worker_login (monadeum_worker), monadeum_indexer_login (monadeum_indexer).
DB_API_PASSWORD=CHANGE_ME
DB_WORKER_PASSWORD=CHANGE_ME
DB_INDEXER_PASSWORD=CHANGE_ME
# monadeum_policy_operator_login (member of monadeum_policy_operator), used only by the on-demand `policy` service to
# append signed risk policy versions (deploy/README.md, step 9). Empty: the role is not created.
DB_POLICY_OPERATOR_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------------------------------------------------
# Redis (internal network only)
# ---------------------------------------------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------------------------------------------------
# Authentication (Privy)
# ---------------------------------------------------------------------------------------------------------------------
# From the Privy dashboard. The app ID is public. The Privy app secret is not used anywhere.
PRIVY_APP_ID=CHANGE_ME
# Optional. Empty (the default): tokens are verified against the keys Privy publishes for the app at
# https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json, selected by kid, so a key rotation needs no change here.
# Set: only this key is used and nothing is fetched (a public key, PEM on one line with literal \n between lines). A
# single key may not verify both access and identity tokens if Privy signs them with different keys.
PRIVY_VERIFICATION_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# API limits
# ---------------------------------------------------------------------------------------------------------------------
# Highest caps an owner may request for a new agent, settlement-asset base units. STARTING: 1 USDC and 5 USDC.
API_MAX_PER_TX_CAP=1000000
API_MAX_DAILY_CAP=5000000
# DECIDED: on testnet agents trade WMON/USDC on our own Kuru market (ARCHITECTURE.md section 10, "Testnet market");
# mainnet stays WETH/USDC. Must equal TRADING_PAIR below.
API_AGENT_PAIR=WMON/USDC
# EVOLUTION.md section 4, the proposed testnet population cap.
API_POPULATION_CAP=50

# ---------------------------------------------------------------------------------------------------------------------
# Funding: "Fund this agent" (ARCHITECTURE.md sections 6.1 and 7)
# ---------------------------------------------------------------------------------------------------------------------
# The owner signs an EIP-3009 transferWithAuthorization of SETTLEMENT_ASSET from the owner wallet to the agent's
# deployed account; the API's relayer submits it and pays the MON gas. The relayer key is created on first boot in its
# own vault (volume relayer_vault, API only); its passphrase is the file deploy/secrets/funding_relayer_vault_passphrase
# (deploy/README.md, step 3), not a variable here. Fund the relayer's address with testnet MON (step 5).
# Largest single relayed transfer, base units. STARTING: 100 USDC.
API_FUNDING_MAX_PER_TRANSFER=100000000
# Relayed transfers per user per rolling 24 hours, whatever their outcome. STARTING value.
API_FUNDING_DAILY_TRANSFERS_PER_USER=3
# How long a prepared authorization stays valid, seconds (60 to 3600). STARTING value.
API_FUNDING_VALIDITY_SECONDS=600

# ---------------------------------------------------------------------------------------------------------------------
# WalletsModule (ZeroDev Kernel v3.1 on EntryPoint 0.7)
# ---------------------------------------------------------------------------------------------------------------------
# ZeroDev bundler URL for chain 10143 (https). It carries the ZeroDev project ID: treat it as a secret, and restrict
# the project to the VPS's IP in ZeroDev's Access Control. FACT, 2026-10-11: the bundler for chain 10143 lists
# EntryPoint 0.7 in eth_supportedEntryPoints (deploy/README.md, step 3).
WALLETS_BUNDLER_URL=https://CHANGE_ME
# ZeroDev paymaster URL (https). Empty: nothing is sponsored and every account pays its own MON.
WALLETS_PAYMASTER_URL=
# Kuru's testnet router and the swap selector anyToAnySwap (0xffa5210a). FACT, Kuru docs and on chain 2026-10-08
# (libs/trading/src/market.ts, KURU_TESTNET_MON_USDC). Time-sensitive. The testnet WMON/USDC market is on this router.
WALLETS_KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
WALLETS_KURU_ROUTER_SELECTORS=0xffa5210a
# reallocate(uint256,bytes32,(address,uint256)[]), the only selector allowed on AgentReallocation.
WALLETS_REALLOCATION_SELECTORS=0x4c329bba
# ERC-20 bases a close sells: Wrapped MON, the testnet market's base. Each agent account's install marks it with the
# spend policy's setTradedAsset before allowing its approve. FACT, Monad docs (testnet) and on chain 2026-10-11:
# symbol WMON, 18 decimals.
WALLETS_TRADED_ASSETS=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
# Sponsorship per agent (deployment included, revocations excluded). STARTING values.
WALLETS_SPONSORED_OPERATIONS=20
WALLETS_SPONSORED_GAS_WEI=500000000000000000
# x402 validator. Empty: no x402 key is created. Once there are testnet providers to pay, set it to the deployed
# X402PaymentValidator, 0xCA918F53FFc7507Bd41602c0bD1ef72558705991 (block 70167461, contracts/deployments/
# monad-testnet.json), and list the providers' pay-to addresses; the payer stays off regardless (below).
WALLETS_X402_VALIDATOR_ADDRESS=
WALLETS_X402_PAYEES=
# DECIDED x402 limits: 0.05 USDC per payment, 4 payments per hour, 300 seconds validity.
WALLETS_X402_MAX_VALUE=50000
WALLETS_X402_PAYMENTS_PER_EPOCH=4
WALLETS_X402_MAX_VALIDITY=300
# The two vault passphrases are not set here: they are files, deploy/secrets/session_vault_passphrase and
# deploy/secrets/x402_vault_passphrase (deploy/README.md, step 4). Use two different passphrases.

# ---------------------------------------------------------------------------------------------------------------------
# Trading market (libs/trading, loadTradingConfig; read by the worker)
# ---------------------------------------------------------------------------------------------------------------------
# DECIDED: our own WMON/USDC market on Kuru's documented testnet router, created and seeded by the owner with
# contracts/script/wmon-market.sh (deploy/README.md, step 2b). The liquidity is ours, so testnet prices and agents' P&L
# carry no economic meaning. TRADING_QUOTE is SETTLEMENT_ASSET and TRADING_QUOTE_DECIMALS is SETTLEMENT_DECIMALS (the
# compose file passes both). Empty TRADING_KURU_MARKET: no market is configured.
TRADING_PAIR=WMON/USDC
TRADING_KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
# PREDICTED, not yet on chain: the router derives the market address from its parameters (CREATE2), and
# `wmon-market.sh create simulate` gave this address on 2026-10-11. After the broadcast, check it against
# contracts/deployments/monad-testnet-wmon-market.json.
TRADING_KURU_MARKET=0x46b66f84317941eC371E7791753f35653341aeBC
TRADING_BASE=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
TRADING_BASE_DECIMALS=18
TRADING_SIZE_PRECISION=10000000000
# The MON price for gas: the mid of the same WMON/USDC book (WMON wraps MON one to one), so it is our seeded price.
TRADING_MON_PRICE_MARKET=0x46b66f84317941eC371E7791753f35653341aeBC
TRADING_MON_PRICE_BASE=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
TRADING_WRAPPED_NATIVE=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541

# ---------------------------------------------------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------------------------------------------------
# DECIDED: one-hour ticks. Fixed for the life of a deployment: changing it renumbers ticks.
WORKER_TICK_INTERVAL_MS=3600000
# DECIDED: the x402 payer is off (ARCHITECTURE.md section 16.3, open question 1).
WORKER_X402_PAYER_ENABLED=false
# The tick runner (ARCHITECTURE.md section 11, "Tick runner"). disabled: every tick is skipped and nothing is sent.
# Set enabled only after the WMON/USDC market is created and seeded and a signed risk policy is appended
# (deploy/README.md, step 9). The worker's chain reads go to MONAD_RPC_URL.
WORKER_TICK_RUNNER=disabled
# The policy operator's address (the `cast wallet address` of its keystore). Every risk policy version must be signed
# by it; the worker skips every tick while no version signed by it verifies. Empty until step 9.
WORKER_POLICY_SIGNER=
# STARTING values: the slippage bound on every order, and how old (seconds) and how wide (bps of the mid) a book
# reading may be before the market signal fails closed.
WORKER_MAX_SLIPPAGE_BPS=100
WORKER_MARKET_MAX_AGE_SECONDS=60
WORKER_MARKET_MAX_SPREAD_BPS=200

# ---------------------------------------------------------------------------------------------------------------------
# Switches
# ---------------------------------------------------------------------------------------------------------------------
# DECIDED: reallocation is off (ARCHITECTURE.md section 5).
MONADEUM_REALLOCATION_ENABLED=false
